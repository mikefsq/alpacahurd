#!/usr/bin/env bash

# build-deb - build alpacahurd .deb packages for Debian, Ubuntu and Raspberry Pi OS.
#
# One package per architecture covers every release. The binary is pure Go and is
# built with CGO_ENABLED=0, so it links no shared library, carries no versioned
# glibc symbol, and installs the same on bookworm, trixie, noble and Raspberry Pi
# OS. A C project needs a container per suite to get this right; this one needs a
# cross-compile, which is why the whole matrix runs on a single runner in seconds.
#
# The package holds the bare orchestrator and the simulated devices. It compiles
# in no hardware driver: each driver ships as its own package and installs beside
# alpacahurd in /usr/bin, where the orchestrator resolves it by name. A fresh
# install therefore serves the sim-* herd and nothing else until a driver package
# is added.
#
# Usage:
#
#   build/build-deb                       # amd64 and arm64 into ./dist
#   build/build-deb -a arm64              # one architecture
#   build/build-deb -v 1.2.3              # override the version
#
# The build needs a Go toolchain, dpkg-deb and file. It needs no root: dpkg-deb
# --root-owner-group writes every path as root:root without one.

set -o pipefail

SCRIPT_DIR=$(cd "${BASH_SOURCE%/*}" && pwd)
SRC_DIR=$(cd "$SCRIPT_DIR/.." && pwd)

PKG=alpacahurd
MAINTAINER="Mike Furlotti <mfurlotti@gmail.com>"
HOMEPAGE=https://github.com/mikefsq/alpacahurd

# Debian architecture names, mapped to GOARCH below. armhf covers 32-bit
# Raspberry Pi OS and is buildable with -a but is not part of the default set.
arches="amd64 arm64"
outdir=$SRC_DIR/dist
version=

usage () {
    cat <<EOF
Usage: build-deb [-a ARCHES] [-o OUTDIR] [-v VERSION]

Options:
 -a ARCHES     space-separated Debian architectures: amd64, arm64, armhf
               [default: $arches]
 -o OUTDIR     directory for the .deb files    [default: $outdir]
 -v VERSION    package version. A tagged commit takes its version from the
               tag; any other commit gets a ~git suffix that sorts below the
               next release.
 -h            show this help
EOF
}

while getopts "a:o:v:h" o; do
    case "${o}" in
        a) arches=$OPTARG ;;
        o) outdir=$OPTARG ;;
        v) version=$OPTARG ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done

for t in go dpkg-deb file; do
    command -v "$t" >/dev/null 2>&1 || { echo "build-deb: $t not found" >&2; exit 1; }
done

# goarch translates a Debian architecture to the GOARCH/GOARM pair that builds it.
goarch () {
    case "$1" in
        amd64) echo "amd64 " ;;
        arm64) echo "arm64 " ;;
        armhf) echo "arm 7" ;;
        *)     return 1 ;;
    esac
}

# resolve_version derives the package version. A commit carrying a vX.Y.Z tag is
# a release and takes X.Y.Z. Any other commit takes the source version with a
# date and abbreviated hash appended after a tilde, which dpkg sorts *below* the
# plain version: 0.1.0~git20260821.9c1f2ab upgrades cleanly to 0.1.0.
resolve_version () {
    local tag base stamp sha
    tag=$(git -C "$SRC_DIR" describe --exact-match --tags HEAD 2>/dev/null)
    if [[ $tag == v[0-9]* ]]; then
        echo "${tag#v}"
        return
    fi
    base=$(sed -n 's/^var version = "v\{0,1\}\(.*\)"$/\1/p' "$SRC_DIR/hurd/run.go" | head -1)
    base=${base:-0.0.0}
    stamp=$(git -C "$SRC_DIR" log -1 --format=%cd --date=format:%Y%m%d 2>/dev/null)
    sha=$(git -C "$SRC_DIR" rev-parse --short=7 HEAD 2>/dev/null)
    if [[ -z $stamp || -z $sha ]]; then
        echo "$base"
    else
        echo "$base~git$stamp.$sha"
    fi
}

# check_package inspects a built package before it is handed over. The static
# link is the property the whole one-package-per-architecture scheme rests on:
# a binary that acquired a dynamic section would need a per-suite build and a
# Depends line that this package does not carry.
check_package () {
    local deb=$1 arch=$2 root rc=0
    root=$(mktemp -d) || return 1

    dpkg-deb -x "$deb" "$root" || { rm -rf "$root"; return 1; }

    local got
    got=$(dpkg-deb -f "$deb" Architecture)
    if [[ $got != "$arch" ]]; then
        echo "$deb: Architecture is $got, expected $arch" >&2
        rc=1
    fi

    if ! file "$root/usr/bin/$PKG" | grep -q "statically linked"; then
        echo "$deb: the binary is not statically linked -- was CGO_ENABLED=0 set?" >&2
        file "$root/usr/bin/$PKG" >&2
        rc=1
    fi

    # The version reaches the binary through -ldflags -X. A stamp that fails to
    # apply leaves the source default behind, which for a release build is the
    # wrong version on the orchestrator page and in every Alpaca description.
    if ! grep -aqF "v$version" "$root/usr/bin/$PKG"; then
        echo "$deb: the binary does not carry the stamped version v$version" >&2
        rc=1
    fi

    # The units are generated from deploy/*.service with the path rewritten.
    # A leftover /usr/local path would leave the service pointing at nothing.
    if grep -rq /usr/local "$root/lib/systemd/system/"; then
        echo "$deb: a unit still refers to /usr/local" >&2
        rc=1
    fi

    if [[ $rc -eq 0 ]]; then
        echo "  Architecture: $arch"
        echo "  Version:      $(dpkg-deb -f "$deb" Version)"
        echo "  Installed:    $(dpkg-deb -f "$deb" Installed-Size) KiB"
    fi
    rm -rf "$root"
    return $rc
}

build_one () {
    local arch=$1 pair ga gm root bin size
    pair=$(goarch "$arch") || { echo "build-deb: unknown architecture '$arch'" >&2; return 1; }
    read -r ga gm <<<"$pair"

    echo "=== $PKG $version $arch ==="

    root=$(mktemp -d) || return 1
    # mktemp -d makes a 0700 directory. It becomes the package's root entry,
    # and dpkg applies its mode to /.
    chmod 0755 "$root"
    bin=$root/usr/bin/$PKG
    mkdir -p "$root/usr/bin" \
             "$root/lib/systemd/system" \
             "$root/lib/udev/rules.d" \
             "$root/usr/share/doc/$PKG/examples" \
             "$root/DEBIAN"

    # -trimpath drops the builder's absolute paths, "-s -w" drops the symbol
    # table and DWARF, and -X stamps the release over the source default.
    # GOFLAGS=-mod=readonly makes the build fail rather than edit go.mod, so a
    # package can only be built from the committed dependency set.
    if ! CGO_ENABLED=0 GOOS=linux GOARCH="$ga" GOARM="$gm" GOFLAGS=-mod=readonly GOWORK=off \
        go build -trimpath \
            -ldflags "-s -w -X github.com/mikefsq/alpacahurd/hurd.version=v$version" \
            -o "$bin" "$SRC_DIR"; then
        rm -rf "$root"
        return 1
    fi
    chmod 0755 "$bin"

    # The shipped units name /usr/local/bin, which is where `sudo make install`
    # puts a source build. A package may not write under /usr/local, so the
    # packaged copies are rewritten to /usr/bin. deploy/*.service stays the one
    # source for their content.
    local unit
    for unit in "$PKG.service" "$PKG-device@.service"; do
        sed 's#/usr/local/bin/#/usr/bin/#g' "$SRC_DIR/deploy/$unit" \
            > "$root/lib/systemd/system/$unit" || return 1
        chmod 0644 "$root/lib/systemd/system/$unit"
    done

    # Packaged udev rules belong under /lib/udev/rules.d. /etc/udev/rules.d is
    # the administrator's directory, and a file placed there by the same name
    # overrides this one.
    install -m 0644 "$SRC_DIR/deploy/99-$PKG.rules" "$root/lib/udev/rules.d/99-$PKG.rules"

    # The simulated devices are the package's self-test, and config/hurd.sim.json
    # is the herd that runs them. `alpacahurd -example-devices` seeds no file for
    # them (a driver package seeds its own, and sims are skipped), so the ready-
    # made config ships here instead:
    #
    #   alpacahurd -config /usr/share/doc/alpacahurd/examples/hurd.sim.json
    install -m 0644 "$SRC_DIR/config/hurd.sim.json" \
        "$root/usr/share/doc/$PKG/examples/hurd.sim.json"
    install -m 0644 "$SRC_DIR/config/hurd.example.json" \
        "$root/usr/share/doc/$PKG/examples/hurd.example.json"

    install -m 0644 "$SRC_DIR/README.md" "$root/usr/share/doc/$PKG/README.md"
    install -m 0644 "$SRC_DIR/DRIVERS.md" "$root/usr/share/doc/$PKG/DRIVERS.md"
    write_copyright "$root/usr/share/doc/$PKG/copyright"
    write_changelog | gzip -9n > "$root/usr/share/doc/$PKG/changelog.Debian.gz"
    chmod 0644 "$root/usr/share/doc/$PKG/changelog.Debian.gz"

    size=$(du -ks "$root" | cut -f1)
    write_control "$arch" "$size" > "$root/DEBIAN/control"
    write_maintainer_scripts "$root/DEBIAN"

    mkdir -p "$outdir"
    local deb=$outdir/${PKG}_${version}_${arch}.deb
    if ! dpkg-deb --root-owner-group -Zxz --build "$root" "$deb" >/dev/null; then
        rm -rf "$root"
        return 1
    fi
    rm -rf "$root"

    check_package "$deb" "$arch" || return 1
    echo "  -> $deb"
}

write_control () {
    cat <<EOF
Package: $PKG
Version: $version
Architecture: $1
Installed-Size: $2
Maintainer: $MAINTAINER
Section: science
Priority: optional
Homepage: $HOMEPAGE
Depends: systemd, udev, init-system-helpers (>= 1.51)
Description: ASCOM Alpaca server for astronomy devices
 alpacahurd serves a herd of ASCOM Alpaca device drivers over HTTP and answers
 Alpaca UDP discovery for all of them. Each device is configured by one JSON
 file, and an orchestrator page at http://host:32227/setup shows the herd,
 edits each configuration and restarts individual devices.
 .
 This package installs the orchestrator and the simulated devices, which serve
 a complete no-hardware herd for verifying an install and developing clients.
 Drivers for real mounts, cameras, focusers, filter wheels and observing
 conditions ship as separate packages and install beside this one.
EOF
}

write_copyright () {
    {
        cat <<EOF
Format: https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/
Upstream-Name: $PKG
Source: $HOMEPAGE

Files: *
Copyright: $(sed -n 's/^Copyright \(.*\)$/\1/p' "$SRC_DIR/LICENSE" | head -1)
License: MIT

License: MIT
EOF
        # The license body is indented one space, and its blank lines become
        # " ." — the Debian copyright format reads an unindented line as the
        # start of the next field.
        sed -e '1,/^$/d' -e 's/^$/./' -e 's/^/ /' "$SRC_DIR/LICENSE"
    } > "$1"
    chmod 0644 "$1"
}

write_changelog () {
    cat <<EOF
$PKG ($version) unstable; urgency=medium

  * Build from $(git -C "$SRC_DIR" rev-parse HEAD 2>/dev/null || echo "an untracked tree").

 -- $MAINTAINER  $(git -C "$SRC_DIR" log -1 --format=%cD 2>/dev/null || date -R)
EOF
}

# write_maintainer_scripts writes postinst, prerm and postrm into a DEBIAN
# directory. They follow what deploy/install.sh does on a source install: the
# config is generated by the binary on first configure and is not a dpkg
# conffile, so an upgrade never prompts and never overwrites an edited file.
write_maintainer_scripts () {
    local d=$1

    cat > "$d/postinst" <<'EOF'
#!/bin/sh
set -e

CONF_DIR=/etc/alpacahurd
STATE_DIR=/var/lib/alpacahurd

if [ "$1" = configure ]; then
	mkdir -p "$CONF_DIR" "$STATE_DIR/devices"

	# The server config carries the shared blocks and no devices. An
	# existing file is kept, so an upgrade leaves an edited config alone.
	if [ ! -f "$CONF_DIR/hurd.json" ]; then
		/usr/bin/alpacahurd -example > "$CONF_DIR/hurd.json"
		chmod 0644 "$CONF_DIR/hurd.json"
	fi

	# One disabled device file per compiled-in driver, beside the server
	# config. Existing files are kept. This package compiles in the
	# simulators only, so a fresh install seeds the sim-* entries and a
	# driver package seeds its own.
	/usr/bin/alpacahurd -example-devices "$CONF_DIR/devices.d" || true

	if [ -d /run/udev ]; then
		udevadm control --reload >/dev/null 2>&1 || true
		udevadm trigger >/dev/null 2>&1 || true
	fi

	deb-systemd-helper unmask alpacahurd.service >/dev/null 2>&1 || true
	if deb-systemd-helper --quiet was-enabled alpacahurd.service; then
		deb-systemd-helper enable alpacahurd.service >/dev/null 2>&1 || true
	else
		deb-systemd-helper update-state alpacahurd.service >/dev/null 2>&1 || true
	fi
fi

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload >/dev/null 2>&1 || true
	if [ "$1" = configure ]; then
		deb-systemd-invoke restart alpacahurd.service >/dev/null 2>&1 || true
	fi
fi

exit 0
EOF

    cat > "$d/prerm" <<'EOF'
#!/bin/sh
set -e

if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
	# Device instances are PartOf= the orchestrator and stop with it. An
	# instance enabled from the orchestrator page is stopped here as well.
	deb-systemd-invoke stop 'alpacahurd-device@*.service' >/dev/null 2>&1 || true
	deb-systemd-invoke stop alpacahurd.service >/dev/null 2>&1 || true
fi

exit 0
EOF

    cat > "$d/postrm" <<'EOF'
#!/bin/sh
set -e

case "$1" in
purge)
	deb-systemd-helper purge alpacahurd.service >/dev/null 2>&1 || true
	deb-systemd-helper unmask alpacahurd.service >/dev/null 2>&1 || true
	# purge removes what the package generated: the seeded configuration
	# and the state the setup pages wrote. remove keeps both.
	rm -rf /etc/alpacahurd /var/lib/alpacahurd
	;;
esac

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload >/dev/null 2>&1 || true
fi
if [ -d /run/udev ]; then
	udevadm control --reload >/dev/null 2>&1 || true
fi

exit 0
EOF

    chmod 0755 "$d/postinst" "$d/prerm" "$d/postrm"
}

[[ -n $version ]] || version=$(resolve_version)

rc=0
built=()
failed=()
for arch in $arches; do
    if build_one "$arch"; then
        built+=("$arch")
    else
        failed+=("$arch")
        rc=1
    fi
done

echo "build-deb: built ${#built[@]} package(s) in $outdir"
if (( ${#failed[@]} )); then
    echo "build-deb: failed: ${failed[*]}" >&2
fi
exit $rc
