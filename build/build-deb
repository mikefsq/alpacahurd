#!/usr/bin/env bash

# Build Debian packages. Requires Go, dpkg-deb, and file; no root needed.
# Usage: build/build-deb [-a "amd64 arm64"] [-v 1.2.3] [-o dist]
set -o pipefail

SCRIPT_DIR=$(cd "${BASH_SOURCE%/*}" && pwd)
SRC_DIR=$(cd "$SCRIPT_DIR/.." && pwd)

PKG=alpacahurd
MAINTAINER="mikefsq <162642838+mikefsq@users.noreply.github.com>"
HOMEPAGE=https://github.com/mikefsq/alpacahurd

# armhf is supported with -a but excluded from the default set.
arches="amd64 arm64"
outdir=$SRC_DIR/dist
version=

usage () {
    cat <<EOF
Usage: build-deb [-a ARCHES] [-o OUTDIR] [-v VERSION]

Options:
 -a ARCHES     space-separated Debian architectures: amd64, arm64, armhf
               [default: $arches]
 -o OUTDIR     directory for the .deb files    [default: $outdir]
 -v VERSION    package version. A tagged commit takes its version from the
               tag; any other commit gets a ~git suffix that sorts below the
               next release.
 -h            show this help
EOF
}

while getopts "a:o:v:h" o; do
    case "${o}" in
        a) arches=$OPTARG ;;
        o) outdir=$OPTARG ;;
        v) version=$OPTARG ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done

for t in go dpkg-deb file; do
    command -v "$t" >/dev/null 2>&1 || { echo "build-deb: $t not found" >&2; exit 1; }
done

# goarch translates a Debian architecture to the GOARCH/GOARM pair that builds it.
goarch () {
    case "$1" in
        amd64) echo "amd64 " ;;
        arm64) echo "arm64 " ;;
        armhf) echo "arm 7" ;;
        *)     return 1 ;;
    esac
}

# resolve_version uses the release tag or a prerelease version with a date and commit hash.
resolve_version () {
    local tag base stamp sha
    tag=$(git -C "$SRC_DIR" describe --exact-match --tags HEAD 2>/dev/null)
    if [[ $tag == v[0-9]* ]]; then
        echo "${tag#v}"
        return
    fi
    base=$(sed -n 's/^var version = "v\{0,1\}\(.*\)"$/\1/p' "$SRC_DIR/hurd/run.go" | head -1)
    base=${base:-0.0.0}
    stamp=$(git -C "$SRC_DIR" log -1 --format=%cd --date=format:%Y%m%d 2>/dev/null)
    sha=$(git -C "$SRC_DIR" rev-parse --short=7 HEAD 2>/dev/null)
    if [[ -z $stamp || -z $sha ]]; then
        echo "$base"
    else
        echo "$base~git$stamp.$sha"
    fi
}

# check_package verifies static linking, version stamping, and installed paths.
check_package () {
    local deb=$1 arch=$2 root rc=0
    root=$(mktemp -d) || return 1

    dpkg-deb -x "$deb" "$root" || { rm -rf "$root"; return 1; }

    local got
    got=$(dpkg-deb -f "$deb" Architecture)
    if [[ $got != "$arch" ]]; then
        echo "$deb: Architecture is $got, expected $arch" >&2
        rc=1
    fi

    if ! file "$root/usr/bin/$PKG" | grep -q "statically linked"; then
        echo "$deb: the binary is not statically linked -- was CGO_ENABLED=0 set?" >&2
        file "$root/usr/bin/$PKG" >&2
        rc=1
    fi

    if ! grep -aqF "v$version" "$root/usr/bin/$PKG"; then
        echo "$deb: the binary does not carry the stamped version v$version" >&2
        rc=1
    fi

    if grep -rq /usr/local "$root/lib/systemd/system/"; then
        echo "$deb: a unit still refers to /usr/local" >&2
        rc=1
    fi

    if [[ $rc -eq 0 ]]; then
        echo "  Architecture: $arch"
        echo "  Version:      $(dpkg-deb -f "$deb" Version)"
        echo "  Installed:    $(dpkg-deb -f "$deb" Installed-Size) KiB"
    fi
    rm -rf "$root"
    return $rc
}

build_one () {
    local arch=$1 pair ga gm root bin size
    pair=$(goarch "$arch") || { echo "build-deb: unknown architecture '$arch'" >&2; return 1; }
    read -r ga gm <<<"$pair"

    echo "=== $PKG $version $arch ==="

    root=$(mktemp -d) || return 1
    # mktemp -d makes a 0700 directory. It becomes the package's root entry,
    # and dpkg applies its mode to /.
    chmod 0755 "$root"
    bin=$root/usr/bin/$PKG
    mkdir -p "$root/usr/bin" \
             "$root/lib/systemd/system" \
             "$root/lib/udev/rules.d" \
             "$root/usr/share/doc/$PKG/examples" \
             "$root/DEBIAN"

    # Disable workspace and dependency edits for reproducible package builds.
    if ! CGO_ENABLED=0 GOOS=linux GOARCH="$ga" GOARM="$gm" GOFLAGS=-mod=readonly GOWORK=off \
        go build -trimpath \
            -ldflags "-s -w -X github.com/mikefsq/alpacahurd/hurd.version=v$version" \
            -o "$bin" "$SRC_DIR"; then
        rm -rf "$root"
        return 1
    fi
    chmod 0755 "$bin"

    # Package binaries belong in /usr/bin; source installs use /usr/local/bin.
    local unit
    for unit in "$PKG.service" "$PKG-device@.service"; do
        sed 's#/usr/local/bin/#/usr/bin/#g' "$SRC_DIR/deploy/$unit" \
            > "$root/lib/systemd/system/$unit" || return 1
        chmod 0644 "$root/lib/systemd/system/$unit"
    done

    # Rules in /etc/udev/rules.d override the packaged rules.
    install -m 0644 "$SRC_DIR/deploy/99-$PKG.rules" "$root/lib/udev/rules.d/99-$PKG.rules"

    # Ship the simulator configuration for installation checks.
    install -m 0644 "$SRC_DIR/config/hurd.sim.json" \
        "$root/usr/share/doc/$PKG/examples/hurd.sim.json"
    install -m 0644 "$SRC_DIR/config/hurd.example.json" \
        "$root/usr/share/doc/$PKG/examples/hurd.example.json"

    install -m 0644 "$SRC_DIR/README.md" "$root/usr/share/doc/$PKG/README.md"
    install -m 0644 "$SRC_DIR/DRIVERS.md" "$root/usr/share/doc/$PKG/DRIVERS.md"
    install -m 0644 "$SRC_DIR/LICENSE" "$root/usr/share/doc/$PKG/LICENSE"
    write_copyright "$root/usr/share/doc/$PKG/copyright"
    write_changelog | gzip -9n > "$root/usr/share/doc/$PKG/changelog.Debian.gz"
    chmod 0644 "$root/usr/share/doc/$PKG/changelog.Debian.gz"

    size=$(du -ks "$root" | cut -f1)
    write_control "$arch" "$size" > "$root/DEBIAN/control"
    write_maintainer_scripts "$root/DEBIAN"

    mkdir -p "$outdir"
    local deb=$outdir/${PKG}_${version}_${arch}.deb
    if ! dpkg-deb --root-owner-group -Zxz --build "$root" "$deb" >/dev/null; then
        rm -rf "$root"
        return 1
    fi
    rm -rf "$root"

    check_package "$deb" "$arch" || return 1
    echo "  -> $deb"
}

write_control () {
    cat <<EOF
Package: $PKG
Version: $version
Architecture: $1
Installed-Size: $2
Maintainer: $MAINTAINER
Section: science
Priority: optional
Homepage: $HOMEPAGE
Depends: systemd, udev, init-system-helpers (>= 1.51)
Description: ASCOM Alpaca server for astronomy devices
 alpacahurd serves a herd of ASCOM Alpaca device drivers over HTTP and answers
 Alpaca UDP discovery for all of them. Each device is configured by one JSON
 file, and an orchestrator page at http://host:32227/setup shows the herd,
 edits each configuration and restarts individual devices.
 .
 This package installs the orchestrator and the simulated devices, which serve
 a complete no-hardware herd for verifying an install and developing clients.
 Drivers for real mounts, cameras, focusers, filter wheels and observing
 conditions ship as separate packages and install beside this one.
EOF
}

write_copyright () {
    {
        cat <<EOF
Format: https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/
Upstream-Name: $PKG
Source: $HOMEPAGE

Files: *
Copyright: $(sed -n 's/^Copyright \(.*\)$/\1/p' "$SRC_DIR/LICENSE" | head -1)
License: GPL-3

License: GPL-3
EOF
        # Debian copyright continuations use indentation and " ." for blank lines.
        sed -e 's/^$/./' -e 's/^/ /' "$SRC_DIR/LICENSE"
    } > "$1"
    chmod 0644 "$1"
}

write_changelog () {
    cat <<EOF
$PKG ($version) unstable; urgency=medium

  * Build from $(git -C "$SRC_DIR" rev-parse HEAD 2>/dev/null || echo "an untracked tree").

 -- $MAINTAINER  $(git -C "$SRC_DIR" log -1 --format=%cD 2>/dev/null || date -R)
EOF
}

# write_maintainer_scripts generates package lifecycle scripts.
# Configuration is seeded on first install and preserved on upgrades.
write_maintainer_scripts () {
    local d=$1

    cat > "$d/postinst" <<'EOF'
#!/bin/sh
set -e

CONF_DIR=/etc/alpacahurd
STATE_DIR=/var/lib/alpacahurd

if [ "$1" = configure ]; then
	mkdir -p "$CONF_DIR" "$STATE_DIR/devices"

	if [ ! -f "$CONF_DIR/hurd.json" ]; then
		/usr/bin/alpacahurd -example > "$CONF_DIR/hurd.json"
		chmod 0644 "$CONF_DIR/hurd.json"
	fi

	# Preserve existing device files.
	/usr/bin/alpacahurd -example-devices "$CONF_DIR/devices.d" || true

	if [ -d /run/udev ]; then
		udevadm control --reload >/dev/null 2>&1 || true
		udevadm trigger >/dev/null 2>&1 || true
	fi

	deb-systemd-helper unmask alpacahurd.service >/dev/null 2>&1 || true
	if deb-systemd-helper --quiet was-enabled alpacahurd.service; then
		deb-systemd-helper enable alpacahurd.service >/dev/null 2>&1 || true
	else
		deb-systemd-helper update-state alpacahurd.service >/dev/null 2>&1 || true
	fi
fi

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload >/dev/null 2>&1 || true
	if [ "$1" = configure ]; then
		deb-systemd-invoke restart alpacahurd.service >/dev/null 2>&1 || true
	fi
fi

exit 0
EOF

    cat > "$d/prerm" <<'EOF'
#!/bin/sh
set -e

if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
	deb-systemd-invoke stop 'alpacahurd-device@*.service' >/dev/null 2>&1 || true
	deb-systemd-invoke stop alpacahurd.service >/dev/null 2>&1 || true
fi

exit 0
EOF

    cat > "$d/postrm" <<'EOF'
#!/bin/sh
set -e

case "$1" in
purge)
	deb-systemd-helper purge alpacahurd.service >/dev/null 2>&1 || true
	deb-systemd-helper unmask alpacahurd.service >/dev/null 2>&1 || true
	# Purge deletes generated configuration and state; remove keeps both.
	rm -rf /etc/alpacahurd /var/lib/alpacahurd
	;;
esac

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload >/dev/null 2>&1 || true
fi
if [ -d /run/udev ]; then
	udevadm control --reload >/dev/null 2>&1 || true
fi

exit 0
EOF

    chmod 0755 "$d/postinst" "$d/prerm" "$d/postrm"
}

[[ -n $version ]] || version=$(resolve_version)

rc=0
built=()
failed=()
for arch in $arches; do
    if build_one "$arch"; then
        built+=("$arch")
    else
        failed+=("$arch")
        rc=1
    fi
done

echo "build-deb: built ${#built[@]} package(s) in $outdir"
if (( ${#failed[@]} )); then
    echo "build-deb: failed: ${failed[*]}" >&2
fi
exit $rc
