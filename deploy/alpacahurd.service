[Unit]
Description=alpacahurd — a herd of ASCOM Alpaca device drivers (mounts, cameras, focusers, filter wheels, observing conditions)
Documentation=https://github.com/mikefsq/alpacahurd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Configuration checks report device errors without blocking other devices.
ExecStartPre=/usr/local/bin/alpacahurd -check -config /etc/alpacahurd/hurd.json
ExecStart=/usr/local/bin/alpacahurd -config /etc/alpacahurd/hurd.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Root permits device service management and hardware access.
User=root

StateDirectory=alpacahurd
ConfigurationDirectory=alpacahurd

[Install]
WantedBy=multi-user.target
