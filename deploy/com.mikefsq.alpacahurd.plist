<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd unit for alpacahurd (the macOS analogue of deploy/alpacahurd.service).
     Installed by deploy/install-macos.sh to /Library/LaunchDaemons/. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mikefsq.alpacahurd</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/alpacahurd</string>
		<string>-config</string>
		<string>/Library/Application Support/alpacahurd/hurd.json</string>
	</array>

	<!-- launchd has no StateDirectory= analogue, so the platform paths are set
	     explicitly (see CONFIG_PLAN.md): config and state under
	     /Library/Application Support/alpacahurd, logs under /Library/Logs. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>ALPACA_SYSTEM_SERVICE</key>
		<string>true</string>
		<key>ALPACA_CONFIG_DIR</key>
		<string>/Library/Application Support/alpacahurd</string>
		<key>ALPACA_STATE_DIR</key>
		<string>/Library/Application Support/alpacahurd/state</string>
		<key>ALPACA_LOG_DIR</key>
		<string>/Library/Logs/alpacahurd</string>
	</dict>

	<!-- Start at boot; restart only after a failure (systemd Restart=on-failure). -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>5</integer>

	<!-- Everything logs to stderr; launchd lands it here. -->
	<key>StandardOutPath</key>
	<string>/Library/Logs/alpacahurd/alpacahurd.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/alpacahurd/alpacahurd.log</string>
</dict>
</plist>
