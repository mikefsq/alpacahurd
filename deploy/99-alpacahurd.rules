# Device permissions for alpacahurd on Linux.
# Install with make install, then replug devices.
# uaccess covers the active desktop session; plugdev covers service accounts.

# ZWO (ASI cameras) — VID 03c3: usbfs for the cameras, hidraw for EAF/EFW.
SUBSYSTEM=="usb", ATTRS{idVendor}=="03c3", MODE="0660", GROUP="plugdev", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="03c3", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# PlayerOne (POA cameras) — VID a0a0.
SUBSYSTEM=="usb", ATTRS{idVendor}=="a0a0", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Astroasis: hidraw access for Oasis focusers and filter wheels.
KERNEL=="hidraw*", ATTRS{idVendor}=="338f", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# scope_hub power and USB hub: hidraw for the scopehub driver.
KERNEL=="hidraw*", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# FTDI serial devices: focusers, observing-condition sensors, and mounts.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", MODE="0660", GROUP="plugdev", TAG+="uaccess"
